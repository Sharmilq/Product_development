<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme for night/dark mode -->
    <style name="Theme.DentNova" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#00BCD4</item>
        <item name="colorPrimaryDark">#0097A7</item>
        <item name="colorAccent">#26C6DA</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Theme attributes for dark mode -->
        <item name="colorSurface">#0F172A</item>
        <item name="colorSurfaceVariant">#1E293B</item>
        <item name="colorOnSurface">#F8FAFC</item>
        <item name="colorOnSurfaceVariant">#94A3B8</item>
        <item name="colorOutline">#334155</item>
    </style>

    <!-- Splash screen theme for night mode -->
    <style name="Theme.DentNova.Splash" parent="Theme.DentNova">
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- White AppBar style (Dark equivalent) -->
    <style name="Theme.DentNova.AppBar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">#1E293B</item>
        <item name="titleTextColor">#F8FAFC</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Primary ElevatedButton style -->
    <style name="Widget.DentNova.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#0F172A</item>
        <item name="backgroundTint">#00BCD4</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Outlined button -->
    <style name="Widget.DentNova.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">#F8FAFC</item>
        <item name="strokeColor">#334155</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- TextField / EditText style -->
    <style name="Widget.DentNova.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#1E293B</item>
        <item name="boxStrokeColor">#334155</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="hintTextColor">#94A3B8</item>
    </style>

    <!-- Card style -->
    <style name="Widget.DentNova.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#1E293B</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Bottom sheet dialog -->
    <style name="Widget.DentNova.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.DentNova.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.DentNova.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeTopLeft">20dp</item>
    </style>

</resources>
