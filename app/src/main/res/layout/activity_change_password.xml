<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_arrow_back_ios"
                    android:tint="?attr/colorOnSurface"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Change Password"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <Space
                    android:layout_width="22dp"
                    android:layout_height="22dp"/>
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="32dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update your password"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="20dp"/>

            <!-- NEW PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Password"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="8dp"/>

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_edittext"
                android:hint="Enter new password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="#9AA8B4"
                android:textSize="15sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="12dp"/>

            <!-- PASSWORD REQUIREMENTS CHECKLIST -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/tvRuleLength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ Minimum 8 characters"
                    android:textColor="?attr/colorError"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvRuleUpper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ One uppercase letter"
                    android:textColor="?attr/colorError"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvRuleLower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ One lowercase letter"
                    android:textColor="?attr/colorError"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvRuleNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ One number"
                    android:textColor="?attr/colorError"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvRuleSpecial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ One special character"
                    android:textColor="?attr/colorError"
                    android:textSize="13sp"/>
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="20dp"/>

            <!-- CONFIRM PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="8dp"/>

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_edittext"
                android:hint="Re-enter new password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="#9AA8B4"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvMatchError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Passwords do not match"
                android:textColor="?attr/colorError"
                android:textSize="13sp"
                android:visibility="gone"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="32dp"/>

            <!-- SUBMIT BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdatePassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Update Password"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#00BCD4"
                app:cornerRadius="26dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
