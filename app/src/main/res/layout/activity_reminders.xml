<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_back_ios"
                app:tint="?attr/colorOnSurface"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reminders"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create multiple reminders for brushing, flossing and toothbrush replacement."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.25"/>

        <Space android:layout_width="0dp" android:layout_height="20dp"/>

        <include
            android:id="@+id/cardBrushing"
            layout="@layout/item_reminder_card"/>

        <Space android:layout_width="0dp" android:layout_height="14dp"/>

        <include
            android:id="@+id/cardFlossing"
            layout="@layout/item_reminder_card"/>

        <Space android:layout_width="0dp" android:layout_height="14dp"/>

        <include
            android:id="@+id/cardToothbrush"
            layout="@layout/item_reminder_card"/>

    </LinearLayout>
</ScrollView>