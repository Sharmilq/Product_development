<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:elevation="0dp"
        app:titleTextColor="?attr/colorOnSurface"
        app:titleTextAppearance="@style/ToolbarTitleStyle" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_education"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:paddingBottom="88dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Learn from bite-sized dental health guides."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:fontFamily="@font/inter_regular" />

            <!-- Did You Know card -->
            <LinearLayout
                android:id="@+id/card_did_you_know"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_did_you_know"
                android:orientation="horizontal"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Tooth icon replaces the plain blue box -->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_tooth_outline"
                    app:tint="?attr/colorPrimary"
                    android:scaleType="fitCenter"/>

                <Space android:layout_width="10dp" android:layout_height="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DID YOU KNOW?"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:fontFamily="@font/inter_regular" />

                    <TextView
                        android:id="@+id/tv_did_you_know_fact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saliva helps protect your teeth by neutralizing acids from food."
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <!-- Refresh hint icon -->
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_auto_awesome"
                    app:tint="?attr/colorPrimary"
                    android:alpha="0.6"
                    android:scaleType="fitCenter"/>

            </LinearLayout>

            <!-- Quiz card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- "QUICK QUIZ" header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_quiz"
                        android:scaleType="fitCenter"/>

                    <Space android:layout_width="6dp" android:layout_height="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUICK QUIZ"
                        android:textColor="#00BCD4"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <Space android:layout_width="0dp" android:layout_height="8dp" />

                <!-- Question -->
                <TextView
                    android:id="@+id/tv_quiz_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How long should you brush your teeth?"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_regular" />

                <Space android:layout_width="0dp" android:layout_height="10dp" />

                <!-- Answer options (vertical column) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Option 0: 1 minute -->
                    <LinearLayout
                        android:id="@+id/btn_opt0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_quiz_option_default"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_opt0"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1 minute"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_regular" />

                        <ImageView
                            android:id="@+id/ic_check0"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#10B981"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option 1: 2 minutes -->
                    <LinearLayout
                        android:id="@+id/btn_opt1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_quiz_option_default"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_opt1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2 minutes"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_regular" />

                        <ImageView
                            android:id="@+id/ic_check1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#10B981"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option 2: 5 minutes -->
                    <LinearLayout
                        android:id="@+id/btn_opt2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_quiz_option_default"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_opt2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="5 minutes"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_regular" />

                        <ImageView
                            android:id="@+id/ic_check2"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#10B981"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option 3 -->
                    <LinearLayout
                        android:id="@+id/btn_opt3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_quiz_option_default"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_opt3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Option 3"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_regular" />

                        <ImageView
                            android:id="@+id/ic_check3"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#10B981"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quiz feedback banner (hidden until answered) -->
                <LinearLayout
                    android:id="@+id/quiz_feedback_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_quiz_feedback"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ic_quiz_feedback"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_celebration" />

                    <Space android:layout_width="8dp" android:layout_height="0dp" />

                    <TextView
                        android:id="@+id/tv_quiz_feedback"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <!-- Explanation TextView (initially GONE) -->
                <TextView
                    android:id="@+id/tv_quiz_explanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="@font/inter_regular"
                    android:visibility="gone" />

                <!-- Try again link (Next Question) -->
                <TextView
                    android:id="@+id/tv_next_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Next Question →"
                    android:textColor="#00BCD4"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_regular"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Article list (non-scrolling RecyclerView inside NestedScrollView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_articles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="0dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>