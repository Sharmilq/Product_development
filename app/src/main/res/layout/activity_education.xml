<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8FA">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="0dp"
        app:titleTextColor="#1A2B3C"
        app:titleTextAppearance="@style/ToolbarTitleStyle" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Learn from bite-sized dental health guides."
                android:textColor="#7A8FA6"
                android:textSize="13sp"
                android:fontFamily="@font/inter_regular" />

            <!-- Did You Know card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_did_you_know"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_did_you_know"
                    android:scaleType="fitCenter"/>

                <Space android:layout_width="10dp" android:layout_height="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DID YOU KNOW?"
                        android:textColor="#00BCD4"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:fontFamily="@font/inter_regular" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saliva helps protect your teeth by neutralizing acids from food."
                        android:textColor="#1A2B3C"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quiz card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- "QUICK QUIZ" header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_quiz"
                        android:scaleType="fitCenter"/>

                    <Space android:layout_width="6dp" android:layout_height="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUICK QUIZ"
                        android:textColor="#00BCD4"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <Space android:layout_width="0dp" android:layout_height="8dp" />

                <!-- Question -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How long should you brush your teeth?"
                    android:textColor="#1A2B3C"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_regular" />

                <Space android:layout_width="0dp" android:layout_height="10dp" />

                <!-- Answer options (horizontal row) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start">

                    <!-- Option 0: 1 minute -->
                    <LinearLayout
                        android:id="@+id/btn_opt0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_quiz_option_default"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_opt0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 minute"
                            android:textColor="#1A2B3C"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_regular" />

                        <ImageView
                            android:id="@+id/ic_check0"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#10B981"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option 1: 2 minutes -->
                    <LinearLayout
                        android:id="@+id/btn_opt1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_quiz_option_default"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_opt1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 minutes"
                            android:textColor="#1A2B3C"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_regular" />

                        <ImageView
                            android:id="@+id/ic_check1"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#10B981"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option 2: 5 minutes -->
                    <LinearLayout
                        android:id="@+id/btn_opt2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_quiz_option_default"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_opt2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 minutes"
                            android:textColor="#1A2B3C"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_regular" />

                        <ImageView
                            android:id="@+id/ic_check2"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#10B981"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quiz feedback banner (hidden until answered) -->
                <LinearLayout
                    android:id="@+id/quiz_feedback_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_quiz_feedback"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ic_quiz_feedback"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_celebration" />

                    <Space android:layout_width="8dp" android:layout_height="0dp" />

                    <TextView
                        android:id="@+id/tv_quiz_feedback"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <!-- Try again link -->
                <TextView
                    android:id="@+id/tv_try_again"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Try again →"
                    android:textColor="#00BCD4"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_regular"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Article list (non-scrolling RecyclerView inside ScrollView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_articles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>