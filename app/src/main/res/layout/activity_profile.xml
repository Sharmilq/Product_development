<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_arrow_back_ios"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Profile"
                    android:textColor="#1A2332"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"/>
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="18dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F3FBFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/civAvatar"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:src="@drawable/home_avatar"
                        app:civ_border_color="#FFFFFF"
                        app:civ_border_width="4dp"/>

                    <Space
                        android:layout_width="18dp"
                        android:layout_height="0dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Name"
                            android:textColor="#1A2332"
                            android:textSize="22sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="example@gmail.com"
                            android:textColor="#6B7B8D"
                            android:textSize="13sp"/>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="10dp"/>

                        <TextView
                            android:id="@+id/tvAgeGender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_profile_pill"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="Age   •   Female"
                            android:textColor="#00BCD4"
                            android:textSize="12sp"/>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="12dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:text="Edit profile"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            app:backgroundTint="#00BCD4"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_edit_outlined"
                            app:iconTint="#FFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Space android:layout_width="0dp" android:layout_height="18dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#D7F8FB"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_white_circle"
                        android:gravity="center"
                        android:text="🔥"
                        android:textSize="18sp"/>

                    <Space android:layout_width="12dp" android:layout_height="0dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStreakTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No streak yet"
                            android:textColor="#1A2332"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Healthy habits in motion — keep going!"
                            android:id="@+id/tvStreakSub"
                            android:textColor="#6B7B8D"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Space android:layout_width="0dp" android:layout_height="20dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Habits"
                android:textColor="#1A2332"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Brushing -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardBrush"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="#F8FEFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <FrameLayout
                                android:layout_width="62dp"
                                android:layout_height="62dp"
                                android:background="@drawable/bg_habit_circle_cyan">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/home_brushing_timer"/>
                            </FrameLayout>

                            <Space android:layout_width="10dp" android:layout_height="0dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:text="Brushing"
                                    android:textColor="#1A2332"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:id="@+id/tvBrushStatus"
                                    android:text="Completed ✓"
                                    android:textColor="#00BCD4"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>


                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Flossing -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFloss"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="#F8FEFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <FrameLayout
                                android:layout_width="62dp"
                                android:layout_height="62dp"
                                android:background="@drawable/bg_habit_circle_purple">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/home_floss"/>
                            </FrameLayout>

                            <Space android:layout_width="10dp" android:layout_height="0dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:text="Flossing"
                                    android:textColor="#1A2332"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:id="@+id/tvFlossStatus"
                                    android:text="Completed ✓"
                                    android:textColor="#7C5CFF"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Achievements"
                android:textColor="#1A2332"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <Space android:layout_width="0dp" android:layout_height="12dp"/>

            <GridLayout
                android:id="@+id/gridAchievements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp">

                        <TextView android:text="🌱" android:textSize="22sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                        <TextView android:text="Hygiene Star" android:textStyle="bold"
                            android:textColor="#1A2332" android:textSize="13sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvHygieneStatus"
                            android:text="Earned"
                            android:textColor="#6B7B8D"
                            android:textSize="11sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp">

                        <TextView android:text="🔁" android:textSize="22sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                        <TextView android:text="Consistent" android:textStyle="bold"
                            android:textColor="#1A2332" android:textSize="13sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvConsistentStatus"
                            android:text="Locked"
                            android:textColor="#6B7B8D"
                            android:textSize="11sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp">

                        <TextView android:text="🏆" android:textSize="22sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                        <TextView android:text="Oral Care Pro" android:textStyle="bold"
                            android:textColor="#1A2332" android:textSize="13sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvProStatus"
                            android:text="Locked"
                            android:textColor="#6B7B8D"
                            android:textSize="11sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp">

                        <TextView android:text="📈" android:textSize="22sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                        <TextView android:text="Improver" android:textStyle="bold"
                            android:textColor="#1A2332" android:textSize="13sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                        <TextView android:id="@+id/tvImproverStatus" android:text="Locked" android:textColor="#6B7B8D"
                            android:textSize="11sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <Space android:layout_width="0dp" android:layout_height="20dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <TextView
                    android:id="@+id/tvAssessments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="22dp"
                    android:text="0 Assessments"
                    android:textColor="#6B7B8D"
                    android:textSize="14sp"/>
            </androidx.cardview.widget.CardView>

            <Space android:layout_width="0dp" android:layout_height="20dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/rowFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Send feedback  ›"
                    android:textColor="#1A2332"
                    android:textSize="14sp"/>
            </androidx.cardview.widget.CardView>

            <Space android:layout_width="0dp" android:layout_height="10dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/rowLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Log out  ›"
                    android:textColor="#E53935"
                    android:textSize="14sp"/>
            </androidx.cardview.widget.CardView>

            <Space android:layout_width="0dp" android:layout_height="40dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>