<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceVariant" app:cardCornerRadius="14dp"
    app:cardElevation="2dp" app:cardUseCompatPadding="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp" android:gravity="center">
        <ImageView
            android:id="@+id/ivActionIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter"/>
        <Space android:layout_width="0dp" android:layout_height="8dp"/>
        <TextView android:id="@+id/tvActionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            android:maxLines="2"/>
        <TextView android:id="@+id/tvActionSub"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular" android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_width="match_parent"
            android:textSize="10sp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
