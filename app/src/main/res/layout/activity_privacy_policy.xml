<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_arrow_back_ios"
                android:tint="?attr/colorOnSurface"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Privacy Policy"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="22dp"
                android:layout_height="22dp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DentNova Privacy Policy"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Last Updated: 2026"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"/>

                <Space android:layout_width="0dp" android:layout_height="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Information We Collect"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="We collect information you provide directly to us, such as your name, email address, age, gender, and oral health concerns when you create an account."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>

                <Space android:layout_width="0dp" android:layout_height="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. How We Use Information"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="The information we collect is used to personalize your DentNova experience, provide oral health assessments, track your habits, and communicate with you about your account."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>

                <Space android:layout_width="0dp" android:layout_height="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. User Accounts"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="You are responsible for safeguarding the credentials used to access DentNova, and you are responsible for any activities under your account."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>

                <Space android:layout_width="0dp" android:layout_height="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Oral Health Data"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="DentNova processes oral health data, including tooth scans, daily brushing and flossing habits, and assessment questionnaire results, strictly to provide you with insights and logs of your dental hygiene."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>

                <Space android:layout_width="0dp" android:layout_height="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. Feedback Submissions"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Any feedback, suggestions, or comments you submit to DentNova is completely voluntary, and we are free to use this information to improve our services without any obligation to you."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>

                <Space android:layout_width="0dp" android:layout_height="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6. Data Security"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="We implement rigorous security measures to protect your personal and oral health data. Your information is securely stored and transmitted using industry-standard encryption protocols."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>

                <Space android:layout_width="0dp" android:layout_height="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7. Contact Us"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="If you have any questions or concerns regarding this Privacy Policy, please contact us via the Feedback section or support email."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>

                <Space android:layout_width="0dp" android:layout_height="40dp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
