<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="48dp" />

        <!-- Logo Box matching auth_screen -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_auth_logo_box">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sentiment_satisfied" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="20dp" />

        <!-- Dynamic Title -->
        <TextView
            android:id="@+id/tvOtpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/inter_bold"
            android:text="@string/title_otp_verify"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="6dp" />

        <!-- Dynamic Subtitle -->
        <TextView
            android:id="@+id/tvOtpSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:text="@string/subtitle_otp_verify"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="20dp" />

        <!-- Info card explaining the Supabase recovery email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_card"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mail_outline"
                android:tint="#00BCD4" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/inter_regular"
                android:text="Check your email for a 6-digit OTP code. It expires in 5 minutes."
                android:textColor="#0097A7"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="20dp" />

        <!-- CONTAINER 1: OTP VERIFICATION STATE -->
        <LinearLayout
            android:id="@+id/layoutOtpState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="Verification Code"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="?attr/colorOutline"
                app:boxBackgroundColor="?attr/colorSurfaceVariant"
                app:startIconDrawable="@drawable/ic_lock_outline"
                app:startIconTint="#9EAAB8"
                app:helperText="Enter the 6-digit code from your email"
                app:helperTextTextColor="#9EAAB8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOtpCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="000000"
                    android:inputType="number"
                    android:maxLength="6"
                    android:gravity="center"
                    android:letterSpacing="0.5"
                    android:textSize="20sp"
                    android:fontFamily="@font/inter_bold"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_verify"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:fontFamily="@font/inter_semibold"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                app:backgroundTint="#00BCD4"
                app:cornerRadius="12dp"
                app:elevation="0dp" />
        </LinearLayout>

        <!-- CONTAINER 2: RESET PASSWORD STATE -->
        <LinearLayout
            android:id="@+id/layoutResetPasswordState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- New Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="@string/new_password_hint"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="?attr/colorOutline"
                app:boxBackgroundColor="?attr/colorSurfaceVariant"
                app:startIconDrawable="@drawable/ic_lock_outline"
                app:startIconTint="#9EAAB8"
                app:endIconMode="password_toggle"
                app:endIconTint="#9EAAB8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvRuleMinLength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ Minimum 8 characters"
                    android:textColor="#E53935"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular" />

                <TextView
                    android:id="@+id/tvRuleUppercase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ One uppercase letter"
                    android:textColor="#E53935"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvRuleLowercase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ One lowercase letter"
                    android:textColor="#E53935"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvRuleNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ One number"
                    android:textColor="#E53935"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvRuleSpecial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✗ One special character"
                    android:textColor="#E53935"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="16dp" />

            <!-- Confirm Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="@string/confirm_password_hint"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="?attr/colorOutline"
                app:boxBackgroundColor="?attr/colorSurfaceVariant"
                app:startIconDrawable="@drawable/ic_lock_outline"
                app:startIconTint="#9EAAB8"
                app:endIconMode="password_toggle"
                app:endIconTint="#9EAAB8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_reset_password"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:fontFamily="@font/inter_semibold"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                app:backgroundTint="#00BCD4"
                app:cornerRadius="12dp"
                app:elevation="0dp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="32dp" />
    </LinearLayout>
</ScrollView>
